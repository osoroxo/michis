{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Michi Rally",
  "version": "0.1.0",
  "identifier": "com.michi.rally",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Michi Rally", "width": 1280, "height": 760, "minWidth": 900, "minHeight": 560, "resizable": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
